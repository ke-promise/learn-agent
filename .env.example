APP_NAME=Incident Review Copilot
ENVIRONMENT=development
STORAGE_BACKEND=postgres
CONVERSATION_BACKEND=redis
OBJECT_STORAGE_BACKEND=minio
POSTGRES_URL=postgresql+psycopg://mini_agent:mini_agent@localhost:5432/mini_agent
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-files
MINIO_SECURE=false
MCP_SERVER_URL=http://localhost:8100/mcp
REMOTE_REPORT_AGENT_URL=http://localhost:8200/report
SQL_AGENT_URL=http://localhost:8300
OCR_ENABLED=true
OCR_MAX_PDF_PAGES=8
